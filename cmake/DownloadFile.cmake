function(download_file url output)
    cmake_parse_arguments(PARSE_ARGV 2 DOWNLOAD "TLS_VERIFY" "EXPECTED_HASH" "")
    set(download_options STATUS status)
    if(DOWNLOAD_TLS_VERIFY)
        list(APPEND download_options TLS_VERIFY ON)
    endif()
    if(DOWNLOAD_EXPECTED_HASH)
        list(APPEND download_options EXPECTED_HASH "${DOWNLOAD_EXPECTED_HASH}")
    endif()

    file(DOWNLOAD "${url}" "${output}" ${download_options})
    list(GET status 0 result)
    if(NOT result EQUAL 0)
        file(REMOVE "${output}")
        message(FATAL_ERROR "Could not download ${url}: ${status}")
    endif()
endfunction()
